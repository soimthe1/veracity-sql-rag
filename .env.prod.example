# Veracity SQL production secrets. Copy to .env.prod next to docker-compose.prod.yaml.
# Only secrets live here; every other setting is in config/config.yaml and
# config/config.prod.yaml, which refer to these by name.

# Catalog Postgres login password (catalog.database.password).
CATALOG_DB_PASSWORD=

# Read-only SQL Server login password, one SRC_<NAME>_PASSWORD per source
# under catalog.sources (the pre-configured source is "primary").
SRC_PRIMARY_PASSWORD=

# Key for an LLM endpoint that needs one. Used only by an ai: profile that
# sets `api_key_env: LLM_API_KEY`. Leave empty for Ollama or an open vLLM server.
LLM_API_KEY=

# Session token signing key (catalog.auth.jwt_secret_env_var), at least 16
# characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
CATALOG_AUTH_JWT_SECRET=

# Password of the read-only AD account in catalog.auth.ldap.search_bind_user
# (directory lookup). Leave empty when that account is not set.
CATALOG_AUTH_LDAP_BIND_PASSWORD=

# Shared key a server-side caller (another application, e.g. a RAG pipeline) sends as
# the X-Service-Key header on POST /v1/ask while sign-in is on.
CATALOG_ANSWER_SERVICE_KEY=
